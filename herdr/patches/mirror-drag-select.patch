+// ---------------------------------------------------------------------------
+// drag selection
+
+/// A drag selection, in LOCAL screen coordinates (0-based row/col).
+///
+/// LOCAL PATCH. That coordinate space is deliberate: it is the same one
+/// `Renderer::paint`'s row loop uses and the same one SGR mouse reports arrive
+/// in, so highlighting and text extraction need no translation. The cost is
+/// that a selection is only meaningful while the screen underneath it holds
+/// still — the caller drops it when a frame rewrites the selected region.
+#[derive(Clone, Copy, PartialEq)]
+pub struct Selection {
+    pub anchor: (usize, usize),
+    pub head: (usize, usize),
+}
+
+impl Selection {
+    pub fn new(row: usize, col: usize) -> Selection {
+        Selection { anchor: (row, col), head: (row, col) }
+    }
+
+    /// a press with no drag: a plain click, nothing to copy
+    pub fn is_empty(&self) -> bool {
+        self.anchor == self.head
+    }
+
+    /// (top-left, bottom-right) — lexicographic on (row, col)
+    fn ordered(&self) -> ((usize, usize), (usize, usize)) {
+        if self.anchor <= self.head {
+            (self.anchor, self.head)
+        } else {
+            (self.head, self.anchor)
+        }
+    }
+
+    /// Inclusive column range selected on local row `r`, or None when the row
+    /// is outside the selection. Middle rows run to the right edge.
+    pub fn cols_on(&self, r: usize, out_cols: usize) -> Option<(usize, usize)> {
+        let ((sr, sc), (er, ec)) = self.ordered();
+        if r < sr || r > er || out_cols == 0 {
+            return None;
+        }
+        let last = out_cols - 1;
+        let from = if r == sr { sc } else { 0 };
+        let to = if r == er { ec } else { last };
+        (from <= last).then(|| (from, to.min(last)))
+    }
+}
+
+/// Row offset of the bottom-anchored window `Renderer::paint` draws. Shared so
+/// text extraction reads exactly the rows the user sees.
+pub fn offset_for(grid: &Grid, out_rows: usize) -> usize {
+    let bottom = grid.content_bottom.max(grid.cursor_row);
+    (bottom + 1).saturating_sub(out_rows)
+}
+
+/// Text under `sel`, read from the same window `paint` draws. Rows are trimmed
+/// at the right like [`Grid::text_lines`]; the last row gets no trailing
+/// newline. Wrapped remote lines cannot be rejoined — frames carry no wrap
+/// flags (see the module header) — so this is strictly what is on screen.
+pub fn selected_text(grid: &Grid, out_cols: usize, out_rows: usize, sel: &Selection) -> String {
+    let offset_r = offset_for(grid, out_rows);
+    let limit = out_cols.min(grid.width);
+    let empty = Vec::new();
+    let mut lines: Vec<String> = Vec::new();
+    for r in 0..out_rows {
+        let Some((from, to)) = sel.cols_on(r, limit) else { continue };
+        let cells = grid.rows.get(r + offset_r).unwrap_or(&empty);
+        let mut s = String::new();
+        let mut c = from;
+        while c <= to {
+            let cell = cells.get(c).and_then(|c| c.as_ref());
+            let ch = cell.map(|c| c.ch).unwrap_or(' ');
+            s.push(ch);
+            // a wide char owns the next column too: skip its spacer cell
+            c += cw(ch);
+        }
+        lines.push(s.trim_end().to_string());
+    }
+    lines.join("\n")
+}
+
