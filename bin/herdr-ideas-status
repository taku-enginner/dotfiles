#!/usr/bin/env bash
# ideas の未消化件数と「高」3件を herdr のサイドバーに1回だけ書く。
#
# 実体は herdr-ticker の ideas サブコマンド。常駐（スクロールし続ける）は
#   herdr-ticker ideas --width 22
# で、launchd の com.taku.ideas-status がそれを持っている。
# こちらは「今すぐ反映したい」ときに手で叩く口。
#
# 2026-09-23: 走査ロジックをこのファイルから herdr-ticker へ移した。
# スクロールには常駐が要り、同じ走査を2箇所に置くと片方だけ古くなるため。
set -uo pipefail

# launchd / cron から呼ばれると PATH が最小構成になる。
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin:${PATH:-}"

exec "${HIS_TICKER:-$HOME/dotfiles/bin/herdr-ticker}" ideas --once \
  --width "${HIS_WIDTH:-22}" "$@"
