{
  "review_point": {
    "prefix": "review",
    "body": [
      "# 先方への連絡",
      "# \t 「挙動に問題はなく」だとざっくり過ぎるので、「正常に削除されており」くらいにする",
      "",
      "# 全体的なこと",
      "# \tなんか改善しても褒められない。新しい事項を指摘されて気が滅入る。",
      "# \t自分が触ったファイルはリファクタしないと怒られる",
      "# \tできるだけrowをそのまま渡して、子やテンプレート先で処理をする",
      "",
      "# DBIx::Class",
      "# \tコネクション（master, slave）は繰り返し処理だったら先に定義しておく",
      "",
      "# Perl",
      "# \tハッシュのキーにシングルクォートは不要",
      "# \tDBに入れるとき、文字列はエンコード不要 $master->resultset('ArticleAnnex')->update_or_insert({  name => 'summary' });",
      "# \t未使用のモジュールやメソッドがインポートされていないか確認！",
      "# \tメソッド呼び出し元と処理が重複していないか確認！（ClaudeAPI呼び出しで、メソッドでも呼び出し側でもリトライしていた）",
      "# \t$article->delete後にログで使用したりしない！deleteは一番最後に書く。",
      "# \tたぶん、ハッシュリファレンスに+{}のプラスを書く",
      "",
      "# 可読性",
      "# \t自分がぱっと説明できないロジックは他の人が見てわからない",
      "# \t極力リファレンスを使う",
      "# \tsearchハッシュではなくリストでよい",
      "# \twarn sprintf は、長くなるようなら改行を入れる。[SKIP]など、ステータスをわかりやすくする"
    ],
    "description": "過去のレビューポイント"
  },
  "if statement": {
    "prefix": "if",
    "body": [
      "if ($1) {",
      "\t$0",
      "}"
    ],
    "description": ""
  },
  "subroutine": {
    "prefix": "sub",
    "body": [
      "sub $1 {",
      "\tmy ($self$2) = @_;",
      "\t$0",
      "}"
    ],
    "description": "メソッド定義"
  },
  "constants": {
    "prefix": "const",
    "body": [
      "use constant {",
      "\t$1 => $2,",
      "};"
    ],
    "description": "定数（use constant）"
  },
  "news_config": {
    "prefix": "conf",
    "body": [
      "use LDNews::Config::MixIn;",
      "use LDNews::Constants qw(:common);"
    ],
    "description": "news config"
  },
  "news_slave": {
    "prefix": "slave",
    "body": [
      "use LDNews::Schema;",
      "my $$slave = LDNews::Schema->connect_slave;",
      "my $$1 = $$slave->resultset('$2')->;"
    ],
    "description": ""
  },
  "news_master": {
    "prefix": "master",
    "body": [
      "use LDNews::Schema;",
      "my $$master = LDNews::Schema->connect_master;",
      "my $$1 = $$master->resultset('$2')->;"
    ],
    "description": ""
  },
  "dumper": {
    "prefix": "dump",
    "body": [
      "use Data::Dumper;",
      "warn Dumper $$1;"
    ],
    "description": "Data::Dumper"
  },
  "sql_dumper": {
    "prefix": "sqldump",
    "body": [
      "$$1->storage->debug(1);"
    ],
    "description": "実行SQLを出す"
  },
  "map": {
    "prefix": "map",
    "body": [
      "my $$1 = [ map { $_->id } @$article ];"
    ],
    "description": "オブジェクトリストからID配列を生成（map）"
  },
  "id_map": {
    "prefix": "idmap",
    "body": [
      "my $$1_map = { map { $_->id => $_ } @$$2配列リファレンス } if @$$3配列リファレンスがあれば;"
    ],
    "description": "hash_ref(map)"
  },
  "foreach": {
    "prefix": "foreach",
    "body": [
      "foreach my $$1 ($$2) {",
      "#早期リターンを念頭に置け",
      "\tnext if $$0;",
      "}"
    ],
    "description": ""
  },
  "log": {
    "prefix": "log",
    "body": [
      "warn sprintf('[FAIL] $1(メッセージ) id=%s', $article->id);"
    ],
    "description": "sprintf形式"
  },
  "hash_ref": {
    "prefix": "hash_ref",
    "body": [
      "my $$1 = {",
      "\t$2 => $$3->id,",
      "};"
    ],
    "description": "hash_ref"
  },
  "dbic_search": {
    "prefix": "search",
    "body": [
      "my @$1 = $$slave->resultset('$2')->search(",
      "\t{",
      "\t\t$3 => $4,",
      "\t},",
      ")->all;"
    ],
    "description": "DBIC：search"
  },
  "dbic_find": {
    "prefix": "find",
    "body": [
      "my $$1 = $$slave->resultset('$2')->find($3);"
    ],
    "description": "DBIC：find"
  },
    "dbic_prefetch": {
    "prefix": "pre",
    "body": [
      "prefetch => [qw/ $1 /],"
    ],
    "description": "DBIC：関連テーブルをJOINして一括取得（N+1問題対策）"
  },
  "dbic_order_by": {
    "prefix": "order",
    "body": [
      "order_by => { -desc => '$1' },"
    ],
    "description": "DBIC：ソート順の指定"
  },
  "dbic_search_like": {
    "prefix": "like",
    "body": [
      "'$1' => { -like => '%$2%' },"
    ],
    "description": "DBIC：LIKE検索（部分一致）"
  },
    "dbic_between": {
    "prefix": "bet",
    "body": [
      "$1 => { -between => [ $2, $3 ] },"
    ],
    "description": "DBIC：範囲検索（BETWEEN）"
  },
  "dbic_in": {
    "prefix": "in",
    "body": [
      "$1 => { -in => [ $2 ] },"
    ],
    "description": "DBIC：複数値のいずれかに一致（IN）"
  },
  "dbic_not_in": {
    "prefix": "notin",
    "body": [
      "$1 => { -not_in => [ $2 ] },"
    ],
    "description": "DBIC：指定した値を含まない（NOT IN）"
  },
  "dbic_is_null": {
    "prefix": "null",
    "body": [
      "$1 => { '=' => nil },"
    ],
    "description": "DBIC：NULL判定（IS NULL）"
  },
  "dbic_is_not_null": {
    "prefix": "notnull",
    "body": [
      "$1 => { '!=' => nil },"
    ],
    "description": "DBIC：非NULL判定（IS NOT NULL）"
  },
  "sql_insert": {
    "prefix": "insert_sql",
    "body": [
      "INSERT INTO $1 ($2, $3) VALUES ($4, $5);"
    ],
    "description": "sql insert文"
  },
  "memo": {
    "prefix": "memo",
    "body": [
      "# ====================",
      "# Perl Memo",
      "# ====================",
      "",
      "# 配列ref",
      "# my $$arr = [1, 2, 3];",
      "",
      "# ハッシュref",
      "# my $$hash_ref = {",
      "#   key => 'value',",
      "# };",
      "",
      "# dereference 配列refやハッシュrefの値を取り出す",
      "# $$arr->[0];",
      "# $$hash_ref->{key};",
      "",
      "# push 配列refの末尾に要素を追加",
      "# my @array = @$$arr;",
      "# push @array, $$value;",
      "",
      "# pop 配列refの末尾の要素を取り出して削除",
      "# my @array = @$$arr;",
      "# pop @array;",
      "",
      "# shift 配列refの先頭の要素を取り出して削除",
      "# my @array = @$$arr;",
      "# shift @array;",
      "",
      "# unshift 配列refの先頭に要素を追加",
      "# my @array = @$$arr;",
      "# unshift @array, $$value;",
      "",
      "# splice 配列refの指定位置の要素を削除・置換",
      "# my @array = @$$arr;",
      "# splice @array, 0, 1;",
      "",
      "# exists ハッシュrefにキーが存在するか確認",
      "# exists $$hash_ref->{key};",
      "",
      "# delete ハッシュrefのキーと値を削除",
      "# delete $$hash_ref->{key};",
      "",
      "# keys ハッシュrefのキー一覧を取得",
      "# my %hash = %$$hash_ref;",
      "# keys %hash;",
      "",
      "# values ハッシュrefの値一覧を取得",
      "# my %hash = %$$hash_ref;",
      "# values %hash;",
      "",
      "# ハッシュ（リファレンス）に追加",
      "# $ハッシュ名->{キー => 値}",
      "",
      "# length 文字列の長さを取得",
      "# length $$str;",
      "",
      "# substr 文字列の一部を取得",
      "# substr($$str, 0, 5);",
      "",
      "# index 文字列の位置を取得",
      "# index($$str, 'foo');",
      "",
      "# join 配列を区切り文字で連結",
      "# my @array = @$$arr;",
      "# join ',', @array;",
      "",
      "# split 文字列を区切り文字で分割して配列refにする",
      "# my $$arr = [ split /,/, $$str ];"
    ],
    "description": "perl開発のメモ"
  },
  "require_test": {
    "prefix": "test",
    "body": [
      "#requre_test"
    ],
    "description": "todo"
  },
  "test_ok": {
    "prefix": "ok",
    "body": [
      "#test_ok"
    ],
    "description": "test_ok"
  },
  "warn_start": {
    "prefix": "start",
    "body": [
      "warn '[start] $1';"
    ],
    "description": "warn start"
  },
  "warn_end": {
    "prefix": "end",
    "body": [
      "warn '[end] $1';"
    ],
    "description": "warn end"
  }
}
