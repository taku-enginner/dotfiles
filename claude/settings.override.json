{
  "skillOverrides": {
    "init": "off",
    "review": "off",
    "run": "off",
    "security-review": "off",
    "simplify": "off",
    "verify": "off"
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/tak/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(/usr/bin/time -f '%es' zsh -i -c exit)"
    ],
    "deny": [
      "Edit(**/.env*)",
      "Edit(**/credentials*)",
      "Edit(**/secrets/**)"
    ]
  }
}
