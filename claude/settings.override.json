{
  "skillOverrides": {
    "init": "off",
    "review": "off",
    "run": "off",
    "security-review": "off",
    "simplify": "off",
    "verify": "off"
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "terminal_bell",
  "permissions": {
    "allow": [
      "Bash(/usr/bin/time -f '%es' zsh -i -c exit)",
      "Bash(awk:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(devbox:*)",
      "Bash(git:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(mysql:*)",
      "Bash(npx:*)",
      "Bash(pkill:*)",
      "Bash(python3:*)",
      "Bash(sed:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(touch:*)",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_drag",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_tabs",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_wait_for"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Edit(**/.env*)",
      "Edit(**/credentials*)",
      "Edit(**/secrets/**)",
      "Read(**/.env*)",
      "Read(**/credentials*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_rsa*)",
      "Write(**/.env*)",
      "Write(**/credentials*)",
      "Write(**/secrets/**)"
    ],
    "defaultMode": "auto"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "python3 \"$HOME/.claude/statusline.py\""
  },
  "sandbox": {
    "enabled": false,
    "excludedCommands": ["ssh"],
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "*.moove.bz",
        "*.npmjs.org",
        "*.pythonhosted.org",
        "files.pythonhosted.org",
        "github.com",
        "pypi.org",
        "registry.npmjs.org"
      ],
      "allowUnixSockets": [
        "/Users/taku/.config/colima/default/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "/Users/taku/myapp/wishlist-widget",
        "/Users/taku/.Trash",
        "/Users/taku/dotfiles"
      ],
      "denyRead": [
        "~/.aws",
        "~/.config/gcloud",
        "~/.gnupg",
        "~/.ssh"
      ],
      "allowRead": [
        "/Users/taku/myapp/kibunrogu/.env"
      ]
    }
  },
  "theme": "auto",
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "statusBar": {
    "enabled": true
  },
  "autoCompact": {
    "enabled": false
  }
}
