.zshrc.env
AuthKey_H8W9N4DNG2.p8
resize-pane
.zcompdump*
nvim/lazy-lock.json
mise.toml

# herdr のランタイム生成物(ログ・セッション状態・ロック)
herdr/*.log
herdr/session.json
herdr/.plugins.lock
# herdr プラグイン: 実体(git checkout + ビルド成果物)とレジストリは herdr が管理する。
# plugins/config/ 配下のユーザ設定はリモートのホスト名・IP を含むため、
# 公開リポジトリであるここでは追跡しない。
herdr/plugins.json
herdr/plugins/
# herdr-lazy が config.toml へ初回書き込みする際に作るバックアップ。
# キーバインドはこちらで手書きするので通常は生成されないが、作られても追跡しない。
herdr/config.toml.herdr-lazy-backup
# Python のバイトコード（bin/ のスクリプトを import したときに出る）
__pycache__/
*.pyc
