# command prompt
precmd() {
  vcs_info
}

git_user_info() {
  if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    local GIT_NAME=$(git config user.name 2>/dev/null)
    local GIT_EMAIL=$(git config user.email 2>/dev/null)

    export PROMPT_GIT_USER="${GIT_NAME} <${GIT_EMAIL}>"
  else
    export PROMPT_GIT_USER=""
  fi
}

INSTANCE_INFO=$(grep -oE '/toro/ec2/[^/]+/[^/]+/[^/]+/i-[0-9a-f]+' /opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log | awk -F'/' '{print $4 "-" $5 " (" $7 ") "}' | tail -n 1)

precmd_functions+=(git_user_info)

if [ $UID -eq 0 ]; then
  PROMPT_SYMBOL='#'
else
  PROMPT_SYMBOL='$'
fi

if [ -z "$INSTANCE_INFO" ]; then
  PROMPT='${WHITE}< %D{%m}/%D{%d} %D{%H}:%D{%M}:%D{%S} > [${HOST_COLOR} ${USER} ${WHITE}|${HOST_COLOR} ${HOST_NAME} ${WHITE}] ${vcs_info_msg_0_} ${PROMPT_GIT_USER} ${GREEN}%d
${WHITE}${PROMPT_SYMBOL}${CLEAR} '
  if [ -n "$CONTAINER_NAME" ]; then
    PROMPT='${WHITE}< %D{%m}/%D{%d} %D{%H}:%D{%M}:%D{%S} > [${HOST_COLOR} ${USER} ${WHITE}|${HOST_COLOR} ${CONTAINER_NAME} ${WHITE}] ${vcs_info_msg_0_} ${PROMPT_GIT_USER} ${GREEN}%d
${WHITE}${PROMPT_SYMBOL}${CLEAR} '
  fi
else
  PROMPT='${WHITE}< %D{%m}/%D{%d} %D{%H}:%D{%M}:%D{%S} > [${HOST_COLOR} ${USER} ${WHITE}|${HOST_COLOR} ${INSTANCE_INFO}${WHITE}] ${vcs_info_msg_0_} ${PROMPT_GIT_USER} ${GREEN}%d
${WHITE}${PROMPT_SYMBOL}${CLEAR} '
fi
